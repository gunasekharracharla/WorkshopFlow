# Copy this file to .env and set your own values before running the app.
APP_ENV=development

# Public white-label branding
BRAND_NAME=WorkshopFlow
BRAND_MARK=WF
BRAND_ACCENT_COLOR="#6b5bdd"
INSTRUCTOR_NAME=Your workshop instructor
INSTRUCTOR_TITLE=Workshop facilitator
INSTRUCTOR_BIO=I help professionals turn expert knowledge into structured learning experiences, premium registrations, and repeatable workshop growth.
INSTRUCTOR_EMAIL=your.email@example.com
PRIVACY_POLICY_URL=
REGISTRATION_TERMS_URL=
# Set true only after a real backup restore check and monitoring setup.
DATA_BACKUPS_VERIFIED=false
PRODUCTION_MONITORING_CONFIGURED=false
PAYMENT_OPERATIONS_REVIEWED=false
ADMIN_RATE_LIMITING_CONFIGURED=false
REGISTRATION_ROLES=Full-Stack Developer,Frontend Developer,Backend Developer,Web Designer,Student/Fresher,Other

# Workshop setup
WORKSHOP_NAME=WorkshopFlow Launch Workshop
WORKSHOP_DATE=To be announced
WORKSHOP_START_TIME=4:00 PM
WORKSHOP_END_TIME=5:30 PM
WORKSHOP_PRICE=399
MAX_SEATS=100
DATABASE_URL=sqlite:///./workshop.db
FRONTEND_URLS=http://localhost:8000,http://127.0.0.1:8000

# Payment and admin secrets: use Razorpay test credentials during development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=
AUTOMATION_WEBHOOK_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
